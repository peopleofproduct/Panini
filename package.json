{
  "name": "panini",
  "version": "0.1.0",
  "private": true,
  "description": "Open-core, zero-dependency financial document and transaction string normalization engine for the Indian FinTech ecosystem.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "jest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "simulate": "tsc -b packages/simulator && node packages/simulator/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=18"
  }
}
