{
  "name": "panini",
  "version": "0.1.0",
  "private": true,
  "description": "Free and open-source, zero-dependency financial data engine for India's fintech ecosystem \u2014 statement extraction, narration normalization, credit insights, ReBIT AA/ONDC/OCEN validators, and a multi-AA FIU client. Runs server-side, at the edge, or fully in-browser. Maintained by People of Product.",
  "license": "Apache-2.0",
  "author": "Kapil",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "jest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "simulate": "tsc -b packages/simulator && node packages/simulator/dist/cli.js",
    "playground": "esbuild playground/web-entry.ts --bundle --format=iife --target=es2020 --alias:node:fs=./playground/fs-stub.js --alias:node:path=./playground/fs-stub.js --outfile=playground/panini-web.js",
    "parse": "node playground/parse.mjs",
    "bench": "node benchmarks/run.mjs",
    "bench:ci": "node benchmarks/run.mjs --ci",
    "check:pins": "node scripts/check-pins.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peopleofproduct/Panini.git"
  },
  "homepage": "https://github.com/peopleofproduct/Panini#readme",
  "bugs": "https://github.com/peopleofproduct/Panini/issues",
  "keywords": [
    "fintech",
    "india",
    "upi",
    "parsing",
    "account-aggregator",
    "ocen",
    "dpi",
    "open-source"
  ],
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
