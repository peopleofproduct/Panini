{
  "id": "axis",
  "bank": "AXIS",
  "version": "1.0.0",
  "description": "Axis Bank narration quirks: P2A/P2M UPI prefixes, ATW withdrawals, INB internet-banking transfers, ACH credit/debit tags.",
  "patterns": [
    {
      "name": "axis_upi_p2",
      "priority": 30,
      "channel": "UPI",
      "media": "narration",
      "regex": "^UPI[\\/]P2[AMP][\\/](?<txnId>\\d{9,18})[\\/](?<counterparty>[^\\/@]+?)(?:@(?<vpaHandle>[A-Za-z0-9._-]+))?(?:[\\/](?<tail>.*))?$",
      "flags": {
        "REV": "REVERSAL",
        "RTN": "REVERSAL",
        "DR": "DEBIT",
        "CR": "CREDIT"
      }
    },
    {
      "name": "axis_atw_withdrawal",
      "priority": 30,
      "channel": "ATM",
      "type": "DEBIT",
      "category": "Cash Withdrawal",
      "media": "narration",
      "regex": "^ATW[-/ ](?<tail>.*)$"
    },
    {
      "name": "axis_inb_transfer",
      "priority": 25,
      "channel": "NETBANKING",
      "media": "narration",
      "regex": "^(?:INB|INET|NEFTINB)[-/ ](?<txnId>\\d{9,16})[-/ ](?<counterparty>[^-/]+)(?:[-/ ](?<tail>.*))?$",
      "flags": {
        "DR": "DEBIT",
        "CR": "CREDIT"
      }
    },
    {
      "name": "axis_ach_tagged",
      "priority": 25,
      "channel": "ACH",
      "media": "narration",
      "regex": "^ACH[-/](?<direction>C|D|CR|DR)[-/ ](?<txnId>[A-Z0-9]{6,18})[-/ ](?<counterparty>.+?)\\s*$",
      "flags": {
        "C": "CREDIT",
        "D": "DEBIT",
        "CR": "CREDIT",
        "DR": "DEBIT"
      }
    },
    {
      "name": "axis_pos_card",
      "priority": 25,
      "channel": "POS",
      "type": "DEBIT",
      "media": "narration",
      "regex": "^(?:POS|VPS|EDC|ECOM)[-/ ](?:(?<cardMask>[\\dX*]{4,19})[-/ ])?(?<counterparty>[^-/]+)(?<tail>\\s*[-/ ].*)?$"
    }
  ]
}
