{
  "$id": "https://panini.dev/schemas/aa-fi-investment.schema.json",
  "description": "ReBIT AA FI data for investment types (EQUITIES, MUTUAL_FUNDS, ETF, BONDS, DEBENTURES, GOVT_SECURITIES, CP, IDR, CIS, AIF, INVIT, REIT, SIP): envelope plus Holdings and optional Transactions.",
  "type": "object",
  "required": ["FIPId", "FIUTimestamp", "maskedAccountNumber", "Holdings"],
  "additionalProperties": true,
  "properties": {
    "FIPId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "FIUTimestamp": { "type": "string", "format": "date-time" },
    "maskedAccountNumber": {
      "type": "string",
      "pattern": "^[Xx*]{0,12}[A-Z0-9]{3,8}$"
    },
    "fiType": {
      "type": "string",
      "enum": [
        "SIP",
        "CP",
        "GOVT_SECURITIES",
        "EQUITIES",
        "BONDS",
        "DEBENTURES",
        "MUTUAL_FUNDS",
        "ETF",
        "IDR",
        "CIS",
        "AIF",
        "INVIT",
        "REIT"
      ]
    },
    "Holdings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["instrumentName"],
        "additionalProperties": true,
        "properties": {
          "instrumentName": { "type": "string", "minLength": 1 },
          "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}\\d$" },
          "units": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,6})?$" },
          "nav": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,4})?$" },
          "investedValue": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
          "currentValue": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
          "rateOfReturn": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,4})?$" }
        }
      }
    },
    "Transaction": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["txnId", "type", "valueDate"],
        "additionalProperties": true,
        "properties": {
          "txnId": { "type": "string", "minLength": 1 },
          "amount": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
          "units": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,6})?$" },
          "nav": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,4})?$" },
          "narration": { "type": "string" },
          "type": { "type": "string", "enum": ["BUY", "SELL", "DEBIT", "CREDIT", "OTHERS"] },
          "valueDate": { "type": "string", "format": "date" },
          "transactionTimestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
