{
  "$id": "https://panini.dev/schemas/ondc-onsearch-catalog.schema.json",
  "description": "ONDC on_search catalog — message.catalog returned by providers (ONDC:FIS domains): provider identity, items with price/xinput, fulfillments, payments, and offer terms.",
  "type": "object",
  "required": ["catalog"],
  "additionalProperties": true,
  "properties": {
    "catalog": {
      "type": "object",
      "required": ["descriptor", "providers"],
      "additionalProperties": true,
      "properties": {
        "descriptor": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "code": { "type": "string" },
            "short_desc": { "type": "string" },
            "long_desc": { "type": "string" }
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "descriptor": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "short_desc": { "type": "string" },
                  "images": { "type": "array", "items": { "type": "object" } }
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "descriptor": { "type": "object" }
                  }
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "descriptor"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "descriptor": {
                      "type": "object",
                      "required": ["name"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "code": { "type": "string" }
                      }
                    },
                    "price": {
                      "type": "object",
                      "properties": {
                        "value": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
                        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                      }
                    },
                    "xinput": {
                      "type": "object",
                      "properties": {
                        "form": {
                          "type": "object",
                          "required": ["id"],
                          "properties": { "id": { "type": "string" } }
                        },
                        "form_response": {
                          "type": "object",
                          "properties": {
                            "status": { "type": "string" },
                            "submission_id": { "type": "string" }
                          }
                        },
                        "required": { "type": "boolean" }
                      }
                    },
                    "tags": { "type": "array", "items": { "type": "object" } }
                  }
                }
              },
              "fulfillments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string" },
                    "customer": { "type": "object" }
                  }
                }
              },
              "payments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string" },
                    "collected_by": { "type": "string", "enum": ["BAP", "BPP"] },
                    "params": {
                      "type": "object",
                      "properties": {
                        "amount": { "type": "string" },
                        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                      }
                    }
                  }
                }
              },
              "tags": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "payments": { "type": "array", "items": { "type": "object" } },
        "tags": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
