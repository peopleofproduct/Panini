{
  "$id": "https://panini.dev/schemas/aa-fi-insurance.schema.json",
  "description": "ReBIT AA FI data for INSURANCE_POLICIES: envelope plus a Policies array.",
  "type": "object",
  "required": ["FIPId", "FIUTimestamp", "maskedAccountNumber", "Policies"],
  "additionalProperties": true,
  "properties": {
    "FIPId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "FIUTimestamp": { "type": "string", "format": "date-time" },
    "maskedAccountNumber": {
      "type": "string",
      "pattern": "^[Xx*]{0,12}[A-Z0-9]{3,8}$"
    },
    "fiType": { "type": "string", "enum": ["INSURANCE_POLICIES"] },
    "Policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["policyNumber", "insurer", "policyType"],
        "additionalProperties": true,
        "properties": {
          "policyNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
          "insurer": { "type": "string", "minLength": 1 },
          "policyType": {
            "type": "string",
            "enum": ["TERM", "ENDOWMENT", "ULIP", "HEALTH", "MOTOR", "ANNUITY", "OTHER"]
          },
          "sumAssured": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
          "premiumAmount": { "type": ["number", "string"], "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
          "premiumFrequency": {
            "type": "string",
            "enum": ["MONTHLY", "QUARTERLY", "HALF_YEARLY", "YEARLY", "SINGLE", "OTHER"]
          },
          "commencementDate": { "type": "string", "format": "date" },
          "maturityDate": { "type": "string", "format": "date" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "LAPSED", "MATURED", "SURRENDERED", "OTHER"]
          }
        }
      }
    }
  }
}
