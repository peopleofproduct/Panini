{
  "$id": "https://panini.dev/schemas/ocen-lifecycle.schema.json",
  "description": "OCEN 4.0 loan lifecycle event — status transitions, disbursement details, repayment schedules, and mandate/eNACH state for a loan application.",
  "type": "object",
  "required": ["metadata", "loanApplicationId", "status"],
  "additionalProperties": true,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "originatorOrgId",
        "originatorParticipantId",
        "traceId",
        "requestId",
        "loanApplicationId"
      ],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "originatorOrgId": { "type": "string", "minLength": 1 },
        "originatorParticipantId": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "loanApplicationId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "loanApplicationId": { "type": "string", "minLength": 4, "maxLength": 64 },
    "status": {
      "type": "string",
      "enum": [
        "APPLICATION_SUBMITTED",
        "OFFER_GENERATED",
        "OFFER_ACCEPTED",
        "KYC_PENDING",
        "AGREEMENT_SIGNED",
        "APPROVED",
        "DISBURSEMENT_PENDING",
        "DISBURSED",
        "ACTIVE",
        "CLOSED",
        "REJECTED",
        "WITHDRAWN",
        "DEFAULTED"
      ]
    },
    "statusReason": { "type": "string" },
    "offer": {
      "type": "object",
      "properties": {
        "sanctionedAmount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "interestRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "tenorMonths": { "type": "integer", "minimum": 1 },
        "processingFeePct": { "type": "number", "minimum": 0 },
        "offerExpiry": { "type": "string", "format": "date-time" }
      }
    },
    "disbursement": {
      "type": "object",
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "utr": { "type": "string" },
        "disbursementDate": { "type": "string", "format": "date-time" },
        "account": {
          "type": "object",
          "properties": {
            "accountNumber": { "type": "string", "pattern": "^\\d{6,18}$" },
            "ifsc": { "type": "string", "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$" }
          }
        }
      }
    },
    "repaymentSchedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["installmentNo", "dueDate", "amount"],
        "properties": {
          "installmentNo": { "type": "integer", "minimum": 1 },
          "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "amount": {
            "type": "object",
            "required": ["total"],
            "properties": {
              "principal": { "type": "number", "minimum": 0 },
              "interest": { "type": "number", "minimum": 0 },
              "total": { "type": "number", "minimum": 0 }
            }
          },
          "status": { "type": "string", "enum": ["DUE", "PAID", "OVERDUE", "WAIVED"] }
        }
      }
    },
    "mandate": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ENACH", "UMN", "PHYSICAL", "NACH"] },
        "status": {
          "type": "string",
          "enum": ["PENDING", "REGISTERED", "ACTIVE", "FAILED", "CANCELLED"]
        },
        "umn": { "type": "string" },
        "amount": { "type": "number", "minimum": 0 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "kfs": {
      "type": "object",
      "description": "RBI Key Facts Statement fields",
      "properties": {
        "annualPercentageRate": { "type": "number", "minimum": 0 },
        "totalRepaymentAmount": { "type": "number", "minimum": 0 },
        "coolingOffDays": { "type": "integer", "minimum": 0 },
        "grievanceOfficerContact": { "type": "string" }
      }
    }
  }
}
