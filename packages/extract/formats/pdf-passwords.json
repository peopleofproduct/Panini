{
  "$schema": "pdf-password-patterns-v1",
  "description": "Password templates for Standard-handler encrypted Indian bank e-statements. {placeholder[:format]} tokens expand from ExtractOptions.credentials — dob formats: ddmmyyyy, ddmmyy, ddmm, yyyymmdd; name4lower/name4upper take the first four letters of the holder name. Ordered most-common-first; explicit credentials.passwords are always tried before templates.",
  "maxCandidates": 64,
  "patterns": [
    { "id": "dob_ddmmyyyy", "bank": "GENERIC", "template": "{dob:ddmmyyyy}" },
    { "id": "name4_dob", "bank": "HDFC", "template": "{name4lower}{dob:ddmmyyyy}" },
    { "id": "name4upper_dob", "bank": "GENERIC", "template": "{name4upper}{dob:ddmmyyyy}" },
    { "id": "account_number", "bank": "SBI", "template": "{accountnumber}" },
    { "id": "dob_ddmmyy", "bank": "GENERIC", "template": "{dob:ddmmyy}" },
    { "id": "pan_dob", "bank": "GENERIC", "template": "{pan}{dob:ddmmyyyy}" },
    { "id": "pan", "bank": "GENERIC", "template": "{pan}" },
    { "id": "custid_dob", "bank": "ICICI", "template": "{customerid}{dob:ddmm}" },
    { "id": "customerid", "bank": "GENERIC", "template": "{customerid}" },
    { "id": "mobile", "bank": "GENERIC", "template": "{mobile}" },
    { "id": "dob_mobile4", "bank": "GENERIC", "template": "{dob:ddmm}{mobile4}" },
    { "id": "name4upper_dobyy", "bank": "GENERIC", "template": "{name4upper}{dob:ddmmyy}" }
  ]
}
